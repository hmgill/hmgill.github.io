diff --git a/_includes/section-resume.html b/_includes/section-resume.html
new file mode 100644
index 0000000..935a046
--- /dev/null
+++ b/_includes/section-resume.html
@@ -0,0 +1,45 @@
+{% if site.data.settings.resume.enable == true %}
+<!-- begin section resume -->
+<section class="section section-resume">
+  <div class="row">
+    <div class="col col-12">
+
+      <div class="section__info">
+        {% if site.data.settings.resume.resume_title %}
+          <h2 class="section__title">{{ site.data.settings.resume.resume_title }}</h2>
+        {% endif %}
+        {% if site.data.settings.resume.resume_description %}
+          <p class="section__description">{{ site.data.settings.resume.resume_description }}</p>
+        {% endif %}
+      </div>
+
+      <div class="row">
+        {% for resume_item in site.data.settings.resume_items %}
+        <div class="col col-6 col-t-12">
+          <div class="resume-item">
+            {% if resume_item.icon %}
+            <div class="resume-item__icon">
+              <i class="{{ resume_item.icon }}"></i>
+            </div>
+            {% endif %}
+            <div class="resume-item__content">
+              <h3 class="resume-item__title">{{ resume_item.title }}</h3>
+              {% if resume_item.description %}
+                <p class="resume-item__description">{{ resume_item.description }}</p>
+              {% endif %}
+              {% if resume_item.file %}
+              <a href="{{ resume_item.file | relative_url }}" class="button resume-item__button" download>
+                Download PDF <i class="fa-solid fa-arrow-down"></i>
+              </a>
+              {% endif %}
+            </div>
+          </div>
+        </div>
+        {% endfor %}
+      </div>
+
+    </div>
+  </div>
+</section>
+<!-- end section resume -->
+{% endif %}
diff --git a/css/_3-modules/section-resume.scss b/css/_3-modules/section-resume.scss
new file mode 100644
index 0000000..f6eda1b
--- /dev/null
+++ b/css/_3-modules/section-resume.scss
@@ -0,0 +1,55 @@
+/* Section Resume */
+.section-resume {
+  .resume-item {
+    display: flex;
+    align-items: flex-start;
+    gap: 16px;
+    height: 100%;
+    padding: 24px;
+    border-radius: 16px;
+    background: var(--background-alt-color);
+  }
+
+  .resume-item__icon {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex-shrink: 0;
+    width: 48px;
+    height: 48px;
+    border-radius: 50%;
+    background: var(--background-color);
+    font-size: 20px;
+    color: var(--heading-font-color);
+  }
+
+  .resume-item__content {
+    display: flex;
+    flex-direction: column;
+  }
+
+  .resume-item__title {
+    margin-bottom: 8px;
+    font-size: 18px;
+  }
+
+  .resume-item__description {
+    margin-bottom: 16px;
+    color: var(--text-alt-color);
+  }
+
+  .resume-item__button {
+    align-self: flex-start;
+
+    i {
+      margin-left: 6px;
+      font-size: 13px;
+    }
+  }
+
+  @media (max-width: $mobile) {
+    .resume-item {
+      flex-direction: column;
+    }
+  }
+}
